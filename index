/* ---------- visible graph ---------- */
const W=2600,H=1560,TOPY=112,BOTY=H-96;
let nodes=[],links=[],overlay=[],nodeById={},dirty=true;
let PREVIDS=null;
const posCache={};

function sectorState(code){const gs=GROUP_IDS.filter(g=>GRP[g].sector===code);
  const n=gs.filter(g=>S.checked.has(g)).length;
  return n===0?0:(n===gs.length?2:1);}
function addNode(proto){if(nodeById[proto.id])return nodeById[proto.id];
  const n=Object.assign({},proto);nodeById[n.id]=n;nodes.push(n);return n;}

function repOf(id){
  if(TOPN[id])return nodeById["t:"+id]?"t:"+id:null;
  if(nodeById[id])return id;
  if(CMP[id]){const c=CMP[id];if(!S.checked.has(c.group))return null;
    if(nodeById["g:"+c.group])return"g:"+c.group;
    if(nodeById["s:"+c.sector])return"s:"+c.sector;return null;}
  if(id&&id.startsWith("g:")){const gid=id.slice(2),g=GRP[gid];
    if(!g||!S.checked.has(gid))return null;
    if(nodeById["s:"+g.sector])return"s:"+g.sector;return null;}
  return null;}

function macroFactorsFor(n){
  if(n.kind==="company"){const out=[];driversOf(n.id).d.forEach(d=>{if(d[2]!=="H")return;
    const r=famRoot(d[0]);if(r&&r.indexOf("m:")===0)out.push(r.slice(2));});
    return[...new Set(out)];}
  if(n.kind==="group"){if(S.expG.has(n.gid))return[];
    return GRP[n.gid].drivers.filter(d=>d[2]==="H").map(d=>d[0]);}
  if(n.kind==="sector"){const sc={};
    GROUP_IDS.filter(g=>GRP[g].sector===n.code&&S.checked.has(g)).forEach(g=>
      GRP[g].drivers.forEach(d=>{sc[d[0]]=(sc[d[0]]||0)+WVAL[d[2]];}));
    return Object.keys(sc).sort((a,b)=>sc[b]-sc[a]).slice(0,3);}
  return[];}
function signFor(n,f){
  if(n.kind==="company"){let s=0;driversOf(n.id).d.forEach(x=>{
    if(famRoot(x[0])==="m:"+f)s+=SGN(x[1])*WVAL[x[2]];});return s>0?1:(s<0?-1:0);}
  if(n.kind==="group"){const d=GRP[n.gid].drivers.find(x=>x[0]===f);return d?SGN(d[1]):0;}
  if(n.kind==="sector"){let s=0;GROUP_IDS.filter(g=>GRP[g].sector===n.code&&S.checked.has(g)).forEach(g=>{
    const d=GRP[g].drivers.find(x=>x[0]===f);if(d)s+=SGN(d[1]);});
    return s>0?1:(s<0?-1:0);}
  return 0;}

function slotX(){const present=SECT_ORDER.filter(c=>sectorState(c)>0);
  const m=180,span=(W-2*m)/Math.max(present.length,1),mp={};
  present.forEach((c,i)=>mp[c]=m+span*(i+.5));return mp;}

function topAnchorX(tid,sx){const xs=[];
  GROUP_IDS.forEach(g=>{if(!S.checked.has(g))return;
    if(GRP[g].toplines.indexOf(tid)>=0&&sx[GRP[g].sector]!=null)xs.push(sx[GRP[g].sector]);});
  if(!xs.length){EDGES.forEach(e=>{if(e[0]!==tid)return;
    memberList(e[1]).forEach(tk=>{const c=CMP[tk];if(c&&sx[c.sector]!=null)xs.push(sx[c.sector]);});
    if(e[1]&&e[1].startsWith("g:")){const g=GRP[e[1].slice(2)];if(g&&sx[g.sector]!=null)xs.push(sx[g.sector]);}});}
  if(!xs.length)return W/2;
  return xs.reduce((a,b)=>a+b,0)/xs.length;}

function buildGraph(){
  nodes=[];nodeById={};
  SECT_ORDER.forEach(code=>{const st=sectorState(code);if(st===0)return;
    if(!S.expS.has(code)){addNode(byId["s:"+code]);return;}
    GROUP_IDS.filter(g=>GRP[g].sector===code&&S.checked.has(g)).forEach(gid=>{
      addNode(byId["g:"+gid]);
      if(S.expG.has(gid))GRP[gid].members.forEach(tk=>{
        if(byId[tk].off&&!S.layers.off)return;addNode(byId[tk]);});});});
  const usedTop=new Set();
  GROUP_IDS.forEach(g=>{if(S.checked.has(g))GRP[g].toplines.forEach(t=>usedTop.add(t));});
  nodes.filter(n=>n.kind==="company").forEach(n=>{const cv=CDRV[n.id];if(cv&&cv.t)cv.t.forEach(t=>usedTop.add(t));});
  usedTop.forEach(t=>{if(TOPN[t]&&TOPN[t].rk!=="reg")addNode(byId["t:"+t]);});
  if(S.edges.reg)EDGES.forEach(e=>{if(e[2]!=="reg")return;
    const tgt=repOf(e[1]);if(tgt)addNode(byId["t:"+e[0]]);});
  if(S.edges.macro){const mset=new Set();
    nodes.slice().forEach(n=>{macroFactorsFor(n).forEach(f=>mset.add(f));});
    MACROS.forEach(m=>{if(mset.has(m[0]))addNode(byId["m:"+m[0]]);});}
  assignPositions();buildLinks();computeOverlay();
  const nids=new Set(Object.keys(nodeById));let dnn=999;
  if(PREVIDS){dnn=0;nids.forEach(i2=>{if(!PREVIDS.has(i2))dnn++;});PREVIDS.forEach(i2=>{if(!nids.has(i2))dnn++;});}
  PREVIDS=nids;
  restartSim(alphaFor(dnn));dirty=true;stateChanged();}

function spreadRow(arr,lo,hi,gap){
  if(arr.length<2)return;
  arr.forEach(n=>{n.ax=Math.max(lo,Math.min(hi,n.ax));});
  for(let i=1;i<arr.length;i++)if(arr[i].ax<arr[i-1].ax+gap)arr[i].ax=arr[i-1].ax+gap;
  if(arr[arr.length-1].ax>hi){arr[arr.length-1].ax=hi;
    for(let i=arr.length-2;i>=0;i--)if(arr[i].ax>arr[i+1].ax-gap)arr[i].ax=arr[i+1].ax-gap;
    for(let i=0;i<arr.length;i++)arr[i].ax=Math.max(arr[i].ax,lo+i*gap);}}
function assignPositions(){
  const sx=slotX();
  const macs=nodes.filter(n=>n.kind==="macro");
  macs.forEach((n,i)=>{n.ax=200+(W-400)*(macs.length>1?i/(macs.length-1):.5);n.fy=BOTY;n.lrow=i%2;});
  nodes.forEach(n=>{
    const c=posCache[n.id];
    if(n.kind==="top"||n.kind==="reg"){n.ax=topAnchorX(n.tid,sx);n.fy=n.kind==="reg"?TOPY+52:TOPY;
      n.x=c?c.x:n.ax;n.y=n.fy;return;}
    if(n.kind==="macro"){n.x=c?c.x:n.ax;n.y=n.fy;return;}
    n.sx=sx[n.kind==="sector"?n.code:(n.kind==="group"?n.sector:CMP[n.id].sector)]||W/2;
    if(c){n.x=c.x;n.y=c.y;}
    else{const hub=n.kind==="company"?nodeById["g:"+CMP[n.id].group]:null;
      const bx=hub&&hub.x?hub.x:n.sx, by=hub&&hub.y?hub.y:H*.5;
      n.x=bx+(Math.random()*90-45);n.y=by+(Math.random()*90-45);}});
  const tops=nodes.filter(n=>n.kind==="top").sort((a,b)=>a.ax-b.ax);
  spreadRow(tops,140,W-140,Math.min(190,(W-280)/Math.max(tops.length-1,1)));
  tops.forEach((n,i)=>{n.lrow=i%2;n.fy=TOPY+(i%2)*30;n.y=n.fy;if(!posCache[n.id])n.x=n.ax;});
  const regs=nodes.filter(n=>n.kind==="reg").sort((a,b)=>a.ax-b.ax);
  spreadRow(regs,140,W-140,Math.min(170,(W-280)/Math.max(regs.length-1,1)));
  regs.forEach(n=>{n.fy=TOPY+62;n.y=n.fy;if(!posCache[n.id])n.x=n.ax;});}

function buildLinks(){
  links=[];const seen={};
  function push(a,b,type,label,w,basis,sign){
    if(!a||!b||a===b)return;const k=a+"|"+b+"|"+type;
    if(seen[k]){if(WVAL[w]>WVAL[seen[k].w]){seen[k].w=w;seen[k].label=label;}seen[k].n++;return;}
    const L={s:a,t:b,type,label,w:w||"M",basis:basis||"",sign:sign==null?null:sign,n:1};
    seen[k]=L;links.push(L);}
  EDGES.forEach(e=>{const ty=e[2];
    if(ty==="reg"&&!S.edges.reg)return;
    if(ty==="link2"&&!S.edges.second)return;
    if(ty==="supply"&&!S.edges.supply)return;
    if(ty==="fund"&&!S.edges.fund)return;
    push(repOf(e[0]),repOf(e[1]),ty==="link2"?"second":ty,e[3],e[4],e[5]);});
  if(S.edges.fund)nodes.forEach(n=>{
    if(n.kind==="company")toplinesOf(n.id).forEach(t=>{if(nodeById["t:"+t])push("t:"+t,n.id,"fund","Top-line funding","M","");});
    else if(n.kind==="group"&&!S.expG.has(n.gid))GRP[n.gid].toplines.forEach(t=>{if(nodeById["t:"+t])push("t:"+t,n.id,"fund","Top-line funding","M","");});
    else if(n.kind==="sector"){const ts=new Set();
      GROUP_IDS.filter(g=>GRP[g].sector===n.code&&S.checked.has(g)).forEach(g=>GRP[g].toplines.forEach(t=>ts.add(t)));
      ts.forEach(t=>{if(nodeById["t:"+t])push("t:"+t,n.id,"fund","Top-line funding","M","");});}});
  if(S.edges.macro)nodes.forEach(n=>{
    if(n.kind==="macro"||n.kind==="top"||n.kind==="reg")return;
    macroFactorsFor(n).forEach(f=>{if(nodeById["m:"+f])push("m:"+f,n.id,"macro",MAC[f].name,"H","",signFor(n,f));});});}

/* shared-dependency overlay: selection neighbours + lens pairs */
const NOISY_FAM=new Set(["turnaround","fx_translation","wage_costs","import_costs","floating_debt","retail_trading","concentration_risk","integration","spinoff_exec","bond_proxy","cap_rates"]);
function famMatch(fa,fb){
  const capA=NOISY_FAM.has(fa)||NOISY_FAM.has(fb);
  if(fa===fb)return{cls:capA?1:3,lca:fa};
  const ca=famChain(fa),cb=famChain(fb);
  for(let i=0;i<ca.length;i++){const j=cb.indexOf(ca[i]);
    if(j<0)continue;const lca=ca[i];
    const isRoot=lca.indexOf("m:")===0||(FAMILIES[lca]&&FAMILIES[lca][0]==="");
    const generic=["program_exec","deal_event","policy","enterprise_it"].indexOf(lca)>=0;
    if(isRoot&&(lca.indexOf("m:")===0||generic))return null;
    let cls=(i<=1&&j<=1)?2:1;if(isRoot)cls=1;if(capA)cls=1;
    return{cls,lca};}
  return null;}
function sharedBetween(a,b){
  const da=driversOf(a).d,db=driversOf(b).d,best={};
  da.forEach(x=>{db.forEach(y=>{const m=famMatch(x[0],y[0]);if(!m)return;
    const w=m.cls*Math.min(WVAL[x[2]],WVAL[y[2]]);
    if(!best[m.lca]||best[m.lca].w<w)best[m.lca]={f:m.lca,w,cls:m.cls,
      same:SGN(x[1])===SGN(y[1])&&SGN(x[1])!==0};});});
  return Object.values(best).sort((p,q)=>q.w-p.w);}
function computeOverlay(){
  overlay=[];S.lensStats=null;stateChanged();
  if(!S.lens)return;
  const byF={};
  allCheckedTk().forEach(tk=>{driversOf(tk).d.forEach(d=>{
    if(d[2]==="L"||NOISY_FAM.has(d[0]))return;
    (byF[d[0]]=byF[d[0]]||[]).push([tk,d[2]]);});});
  const pairs=[];let truePairs=0;const trueByFam={};
  Object.keys(byF).forEach(f=>{const arr=byF[f];if(arr.length<2)return;
    const bySec={};arr.forEach(([tk,w])=>{(bySec[CMP[tk].sector]=bySec[CMP[tk].sector]||[]).push([tk,w]);});
    const secs=Object.keys(bySec);if(secs.length<2)return;
    let tp=0;for(let a2=0;a2<secs.length;a2++)for(let b2=a2+1;b2<secs.length;b2++)tp+=bySec[secs[a2]].length*bySec[secs[b2]].length;
    trueByFam[f]=tp;truePairs+=tp;
    secs.forEach(s=>bySec[s].sort((a,b)=>(WVAL[b[1]]-WVAL[a[1]])||((CMP[b[0]].tier||1)-(CMP[a[0]].tier||1))));
    let cnt=0;
    for(let i2=0;i2<secs.length&&cnt<12;i2++)for(let j2=i2+1;j2<secs.length&&cnt<12;j2++){
      const A=bySec[secs[i2]].slice(0,2),B=bySec[secs[j2]].slice(0,2);
      A.forEach(([a,wa])=>B.forEach(([b,wb])=>{if(cnt>=12)return;
        pairs.push({a,b,f,w:Math.min(WVAL[wa],WVAL[wb])});cnt++;}));}});
  const bund={};
  pairs.forEach(p=>{const ra=repOf(p.a),rb=repOf(p.b);
    if(!ra||!rb||ra===rb)return;
    const k=ra<rb?ra+"|"+rb:rb+"|"+ra;
    const e=(bund[k]=bund[k]||{s:ra,t:rb,n:0,w:0,fams:{}});
    e.n++;e.w+=p.w;e.fams[p.f]=(e.fams[p.f]||0)+p.w;});
  Object.values(bund).sort((a,b)=>b.w-a.w).slice(0,80).forEach(bd=>{
    const top=Object.keys(bd.fams).sort((x,y)=>bd.fams[y]-bd.fams[x])[0];
    const solo=byId[bd.s]&&byId[bd.s].kind==="company"&&byId[bd.t]&&byId[bd.t].kind==="company"&&bd.n===1;
    overlay.push({s:bd.s,t:bd.t,type:"shared",
      label:(solo?"":bd.n+" linked pairs · ")+famName(top),
      w:bd.n>=8?"H":(bd.n>=3?"M":"L")});});
  S.lensStats={pairs:truePairs,drawn:pairs.length,bundles:Math.min(Object.keys(bund).length,80),
    byFam:trueByFam};}

/* ---------- simulation ---------- */
let sim=null;
function clusterForce(alpha){nodes.forEach(n=>{
  if(n.kind!=="company")return;const hub=nodeById["g:"+CMP[n.id].group];if(!hub)return;
  n.vx+=(hub.x-n.x)*.075*alpha;n.vy+=(hub.y-n.y)*.075*alpha;});}
function bandClamp(){nodes.forEach(n=>{
  if(n.kind==="top"||n.kind==="reg"||n.kind==="macro")return;
  const lo=TOPY+120,hi=BOTY-110;
  if(n.y<lo)n.y=lo;if(n.y>hi)n.y=hi;
  if(n.x<70)n.x=70;if(n.x>W-70)n.x=W-70;});}
function radiusOf(n){
  if(n.kind==="company")return 4.5+(n.tier||1)*1.9;
  if(n.kind==="group"){const g=GRP[n.gid];return 8+Math.sqrt(g?g.members.length:4)*1.7;}
  if(n.kind==="sector")return 21+SECTORS[n.code].wt*.5;
  if(n.kind==="top")return 11;
  if(n.kind==="reg")return 8.5;
  return 7;}
function restartSim(alpha){alpha=alpha==null?.95:alpha;
  if(sim)sim.stop();
  const simLinks=links.filter(l=>l.type==="supply"||l.type==="second").map(l=>({source:l.s,target:l.t}));
  sim=d3.forceSimulation(nodes)
    .force("x",d3.forceX(d=>d.ax!=null?d.ax:(d.sx||W/2)).strength(d=>
      d.kind==="macro"?.6:(d.kind==="top"||d.kind==="reg")?.3:d.kind==="sector"?.25:d.kind==="group"?.16:.07))
    .force("y",d3.forceY(d=>d.kind==="group"?H*.46:H*.5).strength(d=>
      (d.kind==="top"||d.kind==="reg"||d.kind==="macro")?0:.05))
    .force("charge",d3.forceManyBody().strength(d=>d.kind==="company"?-40:-95).distanceMax(360))
    .force("collide",d3.forceCollide(d=>radiusOf(d)+4.5).iterations(2))
    .force("link",d3.forceLink(simLinks).id(d=>d.id).distance(125).strength(.045))
    .force("cluster",clusterForce)
    .alpha(alpha).alphaDecay(.032)
    .on("tick",()=>{bandClamp();dirty=true;})
    .on("end",()=>{nodes.forEach(n=>{posCache[n.id]={x:n.x,y:n.y};});});}

/* ---------- canvas ---------- */
const canvas=$("cv"),ctx=canvas.getContext("2d"),stage=$("stage");
let T=d3.zoomIdentity,dpr=1;
const zoom=d3.zoom().scaleExtent([.15,7]).on("zoom",ev=>{T=ev.transform;dirty=true;});
d3.select(canvas).call(zoom).on("dblclick.zoom",null);
function resize(){dpr=window.devicePixelRatio||1;
  canvas.width=stage.clientWidth*dpr;canvas.height=stage.clientHeight*dpr;
  canvas.style.width=stage.clientWidth+"px";canvas.style.height=stage.clientHeight+"px";dirty=true;}
window.addEventListener("resize",resize);

function neighborSet(id){const s=new Set([id]);
  links.forEach(l=>{if(l.s===id)s.add(l.t);if(l.t===id)s.add(l.s);});
  overlay.forEach(l=>{if(l.s===id)s.add(l.t);if(l.t===id)s.add(l.s);});
  return s;}
function shockInfo(id){if(!S.shockMap)return null;
  if(CMP[id])return{v:S.shockMap[id]||0,m:S.shockMap[id]||0,n:S.shockMap[id]!=null?1:0,N:1};
  let mm=memberList(id);
  if(!mm.length&&id&&id.startsWith("s:")){const code=id.slice(2);mm=[];
    GROUP_IDS.forEach(g=>{if(GRP[g].sector===code&&S.checked.has(g))GRP[g].members.forEach(tk=>mm.push(tk));});}
  if(!mm.length)return null;
  let s=0,c=0;mm.forEach(tk=>{if(S.shockMap[tk]!=null){s+=S.shockMap[tk];c++;}});
  if(!c)return{v:0,m:0,n:0,N:mm.length};
  return{v:(s/c)*Math.sqrt(c/mm.length),m:s/c,n:c,N:mm.length};}
function shockOf(id){const si=shockInfo(id);return si?si.v:0;}
function hexA(hex,a){const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  return"rgba("+r+","+g+","+b+","+a+")";}

function drawEdge(l,faded){
  const a=nodeById[l.s],b=nodeById[l.t];if(!a||!b)return;
  const w=WVAL[l.w]||2;let stroke,lw,dash=null,alpha;
  if(l.type==="fund"){stroke=CLR.brass;lw=2.2+w*1.1;alpha=faded?.05:.14;}
  else if(l.type==="supply"){stroke=CLR.brass;lw=.7+w*.5;alpha=faded?.08:.5;}
  else if(l.type==="reg"){stroke=CLR.reg;lw=1.1;dash=[2,4];alpha=faded?.08:.5;}
  else if(l.type==="macro"){stroke=l.sign>0?CLR.pos:(l.sign<0?CLR.neg:CLR.macro);lw=.8;alpha=faded?.04:.22;}
  else if(l.type==="shared"){stroke=CLR.shared;lw=1.4;dash=[5,4];alpha=faded?.1:.75;}
  else{stroke=CLR.second;lw=1.2;dash=[6,4];alpha=faded?.08:.6;}
  ctx.strokeStyle=hexA(stroke,alpha);ctx.lineWidth=lw/T.k*Math.min(T.k,1.6);
  if(dash)ctx.setLineDash(dash.map(d=>d/Math.sqrt(T.k)));else ctx.setLineDash([]);
  const mx=(a.x+b.x)/2,my=(a.y+b.y)/2,dx=b.x-a.x,dy=b.y-a.y,dist=Math.sqrt(dx*dx+dy*dy)||1;
  const bend=(l.type==="macro"||l.type==="fund")?0:Math.min(26,dist*.08);
  const cx=mx-dy/dist*bend,cy=my+dx/dist*bend;
  ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.quadraticCurveTo(cx,cy,b.x,b.y);ctx.stroke();
  if((l.type==="supply"||l.type==="fund")&&!faded&&T.k>.5){
    const t=.62,qx=(1-t)*(1-t)*a.x+2*(1-t)*t*cx+t*t*b.x,qy=(1-t)*(1-t)*a.y+2*(1-t)*t*cy+t*t*b.y;
    const ang=Math.atan2(b.y-qy,b.x-qx),ar=4.2/Math.sqrt(T.k);
    ctx.fillStyle=hexA(stroke,Math.min(alpha*1.6,.85));
    ctx.beginPath();ctx.moveTo(qx+Math.cos(ang)*ar,qy+Math.sin(ang)*ar);
    ctx.lineTo(qx+Math.cos(ang+2.5)*ar,qy+Math.sin(ang+2.5)*ar);
    ctx.lineTo(qx+Math.cos(ang-2.5)*ar,qy+Math.sin(ang-2.5)*ar);
    ctx.closePath();ctx.fill();}
  ctx.setLineDash([]);}

function drawNode(n,dimmed){
  const r=radiusOf(n),sh=shockOf(n.id);
  let fill,stroke,lw=1.2;
  const sc=n.kind==="company"?SECTORS[CMP[n.id].sector].color:
    n.kind==="group"?SECTORS[n.sector].color:
    n.kind==="sector"?SECTORS[n.code].color:null;
  if(n.kind==="top"){fill="#171308";stroke=CLR.brass;lw=1.5;}
  else if(n.kind==="reg"){fill="#12141a";stroke=CLR.reg;}
  else if(n.kind==="macro"){fill="#101521";stroke=CLR.macro;}
  else{fill=hexA(sc,n.kind==="company"?.85:(n.kind==="group"?.25:.16));stroke=sc;}
  if(S.shockMap&&sh){const mag=Math.min(Math.abs(sh)/4,1);
    fill=hexA(sh>0?CLR.pos:CLR.neg,.25+.65*mag);stroke=sh>0?CLR.pos:CLR.neg;}
  const gA=dimmed?.14:1;
  ctx.globalAlpha=gA;
  ctx.beginPath();
  if(n.kind==="top"){ctx.moveTo(n.x,n.y-r);ctx.lineTo(n.x+r,n.y);ctx.lineTo(n.x,n.y+r);ctx.lineTo(n.x-r,n.y);ctx.closePath();}
  else if(n.kind==="reg"){ctx.rect(n.x-r,n.y-r,2*r,2*r);}
  else if(n.kind==="macro"){ctx.moveTo(n.x,n.y+r);ctx.lineTo(n.x+r*.95,n.y-r*.75);ctx.lineTo(n.x-r*.95,n.y-r*.75);ctx.closePath();}
  else ctx.arc(n.x,n.y,r,0,Math.PI*2);
  ctx.fillStyle=fill;ctx.fill();
  if(n.kind==="company"&&byId[n.id].off)ctx.setLineDash([3,2.5]);
  ctx.strokeStyle=(S.sel===n.id||S.cmp.indexOf(n.id)>=0)?CLR.brass:stroke;
  ctx.lineWidth=(S.sel===n.id?2.4:lw)/Math.sqrt(T.k);
  ctx.stroke();ctx.setLineDash([]);
  if(n.kind==="group"&&!S.expG.has(n.gid)&&T.k>.45){
    ctx.fillStyle=hexA(CLR.ivory,.85);
    ctx.font=(9/T.k*Math.min(T.k,1.4))+"px "+getComputedStyle(document.body).getPropertyValue("--mono");
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText(String(GRP[n.gid].members.length),n.x,n.y);}
  if(S.layers.cb&&S.shockMap&&sh&&T.k>.7&&n.kind!=="macro"){
    const gsz=Math.max(3,r*.45)/Math.sqrt(T.k),gx=n.x+r+gsz+2/Math.sqrt(T.k),gy=n.y;
    ctx.beginPath();
    if(sh>0){ctx.moveTo(gx,gy-gsz);ctx.lineTo(gx+gsz*.85,gy+gsz*.6);ctx.lineTo(gx-gsz*.85,gy+gsz*.6);}
    else{ctx.moveTo(gx,gy+gsz);ctx.lineTo(gx+gsz*.85,gy-gsz*.6);ctx.lineTo(gx-gsz*.85,gy-gsz*.6);}
    ctx.closePath();ctx.fillStyle=sh>0?CLR.pos:CLR.neg;ctx.fill();
    ctx.lineWidth=1/T.k;ctx.strokeStyle=hexA(CLR.ink,.9);ctx.stroke();}
  ctx.globalAlpha=1;}

let LBOXES=[];
function rectsOverlap(a,b){return a[0]<b[0]+b[2]&&b[0]<a[0]+a[2]&&a[1]<b[1]+b[3]&&b[1]<a[1]+a[3];}
function labelSpec(n,dimmed){
  const r=radiusOf(n);let txt=null,font,fs,col=CLR.ivory;
  const mono=getComputedStyle(document.body).getPropertyValue("--mono");
  const serif=getComputedStyle(document.body).getPropertyValue("--serif");
  if(n.kind==="company"){if(T.k*r<6.5&&S.sel!==n.id&&S.hover!==n.id)return null;
    txt=n.id;fs=10.5/T.k*Math.min(T.k,1.5);font=fs+"px "+mono;col=hexA(CLR.ivory,dimmed?.15:.92);}
  else if(n.kind==="group"){if(S.expG.has(n.gid)&&T.k<.65)return null;
    txt=n.label;fs=11/T.k*Math.min(T.k,1.35);font=fs+"px "+serif;col=hexA(CLR.ivory,dimmed?.15:(S.expG.has(n.gid)?.55:.85));}
  else if(n.kind==="sector"){txt=n.label;fs=14.5/T.k*Math.min(T.k,1.25);font=fs+"px "+serif;col=hexA(CLR.ivory,dimmed?.2:.95);}
  else if(n.kind==="top"||n.kind==="reg"){txt=n.label;fs=10.5/T.k*Math.min(T.k,1.4);
    font=fs+"px "+serif;col=hexA(n.kind==="top"?CLR.brass:CLR.reg,dimmed?.2:.95);}
  else{if(T.k<.5)return null;txt=n.label;fs=9.5/T.k*Math.min(T.k,1.4);font=fs+"px "+serif;col=hexA("#8496b4",dimmed?.15:.85);}
  const below=n.kind==="macro";
  const off=(below&&n.lrow)?13/T.k:0;
  const ly=below?n.y+r+3/T.k+off:n.y-r-4/T.k;
  return{txt,font,fs,col,ly,below};}
function drawLabel(n,dimmed){
  const sp=labelSpec(n,dimmed);if(!sp)return;
  ctx.font=sp.font;ctx.textAlign="center";
  ctx.textBaseline=sp.below?"top":"alphabetic";
  const wpx=ctx.measureText(sp.txt).width;
  const sx0=(n.x-wpx/2)*T.k+T.x,sy0=(sp.below?sp.ly:sp.ly-sp.fs)*T.k+T.y;
  const box=[sx0-2,sy0-1,wpx*T.k+4,sp.fs*T.k+2];
  const pri=S.sel===n.id||S.hover===n.id;
  if(!pri){for(let i=0;i<LBOXES.length;i++)if(rectsOverlap(box,LBOXES[i]))return;}
  LBOXES.push(box);
  ctx.lineWidth=3/T.k;ctx.strokeStyle=hexA(CLR.ink,.85);
  ctx.strokeText(sp.txt,n.x,sp.ly);ctx.fillStyle=sp.col;ctx.fillText(sp.txt,n.x,sp.ly);}

function draw(){
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,canvas.width/dpr,canvas.height/dpr);
  ctx.translate(T.x,T.y);ctx.scale(T.k,T.k);
  const focus=S.sel||S.hover;
  const nb=focus?neighborSet(focus):null;
  ctx.strokeStyle=hexA(CLR.ivory,.05);ctx.lineWidth=1/T.k;ctx.setLineDash([4,6]);
  ctx.beginPath();ctx.moveTo(60,TOPY+64);ctx.lineTo(W-60,TOPY+64);
  ctx.moveTo(60,BOTY-52);ctx.lineTo(W-60,BOTY-52);ctx.stroke();ctx.setLineDash([]);
  const order={fund:0,macro:1,reg:2,second:3,supply:4,shared:5};
  links.slice().sort((a,b)=>order[a.type]-order[b.type]).forEach(l=>{
    if(l.type==="macro"&&!macroLinkOK(l))return;
    const faded=nb?!(nb.has(l.s)&&nb.has(l.t))&&!(l.s===focus||l.t===focus):false;
    drawEdge(l,faded);});
  overlay.forEach(l=>{if(nodeById[l.s]&&nodeById[l.t])drawEdge(l,false);});
  nodes.forEach(n=>drawNode(n,nb?!nb.has(n.id):false));
  if(S.layers.labels){LBOXES=[];
    const KP={sector:0,top:1,reg:1,macro:2,group:3,company:4};
    nodes.slice().sort((a,b)=>{
      const fa=(S.sel===a.id||S.hover===a.id)?-1:KP[a.kind],fb=(S.sel===b.id||S.hover===b.id)?-1:KP[b.kind];
      if(fa!==fb)return fa-fb;return (b.tier||0)-(a.tier||0);}).forEach(n=>drawLabel(n,nb?!nb.has(n.id):false));}}

function loop(){if(dirty){draw();dirty=false;}requestAnimationFrame(loop);}

function pick(mx,my){
  const wx=(mx-T.x)/T.k,wy=(my-T.y)/T.k;let best=null,bd=1e9;
  for(let i=nodes.length-1;i>=0;i--){const n=nodes[i];
    const r=radiusOf(n)+Math.max(3,5/T.k);
    const d=(n.x-wx)*(n.x-wx)+(n.y-wy)*(n.y-wy);
    if(d<r*r&&d<bd){bd=d;best=n;}}
  return best;}

function centerOn(id,k){const n=nodeById[id];if(!n)return;
  const kk=k||Math.max(T.k,1.1);
  const t=d3.zoomIdentity.translate(stage.clientWidth/2-n.x*kk,stage.clientHeight/2-n.y*kk).scale(kk);
  d3.select(canvas).transition().duration(420).call(zoom.transform,t);}
function fitView(){if(!nodes.length)return;
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  nodes.forEach(n=>{x0=Math.min(x0,n.x);x1=Math.max(x1,n.x);y0=Math.min(y0,n.y);y1=Math.max(y1,n.y);});
  const pad=80,k=Math.min(2,Math.min(stage.clientWidth/(x1-x0+2*pad),stage.clientHeight/(y1-y0+2*pad)));
  const t=d3.zoomIdentity.translate(stage.clientWidth/2-k*(x0+x1)/2,stage.clientHeight/2-k*(y0+y1)/2).scale(k);
  d3.select(canvas).transition().duration(420).call(zoom.transform,t);}

