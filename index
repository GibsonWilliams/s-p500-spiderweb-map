function parseCSVMatrix(txt){
  const lines=String(txt||"").split(/\r?\n/).filter(l=>l.trim());
  if(lines.length<2)return{err:"Need a header row plus data rows."};
  const nc=(lines[0].match(/,/g)||[]).length,nt=(lines[0].match(/\t/g)||[]).length,ns=(lines[0].match(/;/g)||[]).length;
  const delim=nt>nc&&nt>ns?"\t":(ns>nc?";":",");
  const head=lines[0].split(delim).map(h=>h.trim().replace(/^"|"$/g,"").toUpperCase());
  let c0=CMP[head[0]]?0:1;
  const tks=[],cols=[];
  for(let j=c0;j<head.length;j++){if(CMP[head[j]]&&tks.indexOf(head[j])<0){tks.push(head[j]);cols.push(j);}}
  if(tks.length<3)return{err:"Fewer than 3 recognizable tickers in the header row."};
  const M=[];
  for(let i=1;i<lines.length;i++){const cells=lines[i].split(delim);
    M.push(cols.map(j=>{const v=parseFloat(cells[j]);return isFinite(v)?v:NaN;}));}
  let pos=0,tot=0,big=0;M.forEach(r2=>r2.forEach(v=>{if(isFinite(v)){tot++;if(v>0)pos++;if(Math.abs(v)>2)big++;}}));
  if(!tot)return{err:"No numeric cells parsed."};
  const prices=(pos/tot>.98)&&(big/tot>.5);
  let R=M;
  if(prices){R=[];for(let i=1;i<M.length;i++)R.push(M[i].map((v,j)=>(isFinite(v)&&isFinite(M[i-1][j])&&M[i-1][j]>0)?Math.log(v/M[i-1][j]):NaN));}
  if(R.length<40)return{err:"Only "+R.length+" return rows after parsing \u2014 need at least 40."};
  return{tks,R,prices,rows:R.length};}
function pairCorr(R,a,b){
  let n=0,sa=0,sb=0,saa=0,sbb=0,sab=0;
  for(let i=0;i<R.length;i++){const x=R[i][a],y=R[i][b];
    if(!isFinite(x)||!isFinite(y))continue;
    n++;sa+=x;sb+=y;saa+=x*x;sbb+=y*y;sab+=x*y;}
  if(n<40)return null;
  const cov=sab/n-(sa/n)*(sb/n),va=saa/n-(sa/n)*(sa/n),vb=sbb/n-(sb/n)*(sb/n);
  if(va<=0||vb<=0)return null;
  return{r:cov/Math.sqrt(va*vb),n};}
function pairLink(a,b){const sh=sharedBetween(a,b);
  if(!sh.length)return{cls:0,w:0,fams:[]};
  let mx=0,w=0;sh.forEach(x=>{mx=Math.max(mx,x.cls);w+=x.w;});
  return{cls:mx,w,fams:sh.slice(0,3).map(x=>x.f)};}
function corrAnalyze(pr,fl,ce){
  const tks=pr.tks,n=tks.length;
  const buckets=[{s:0,c:0},{s:0,c:0},{s:0,c:0}];
  const miss=[],silent=[];
  for(let i=0;i<n;i++)for(let j=i+1;j<n;j++){
    const pc=pairCorr(pr.R,i,j);if(!pc)continue;
    const a=tks[i],b=tks[j],lk=pairLink(a,b);
    const bk=lk.cls>=2?2:(lk.cls===1?1:0);
    buckets[bk].s+=Math.abs(pc.r);buckets[bk].c++;
    if(bk===0&&pc.r>=fl&&CMP[a].group!==CMP[b].group)
      miss.push({a,b,r:pc.r,sameSec:CMP[a].sector===CMP[b].sector});
    if(bk===2&&Math.abs(pc.r)<=ce)silent.push({a,b,r:pc.r,w:lk.w,fams:lk.fams});}
  miss.sort((x,y)=>y.r-x.r);silent.sort((x,y)=>y.w-x.w);
  return{buckets,miss:miss.slice(0,20),silent:silent.slice(0,20)};}
