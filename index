    else if(ev.key==="Enter"){const el=items[srSel>=0?srSel:0];
      if(el){reveal(el.getAttribute("data-id"));box.style.display="none";inp.blur();}return;}
    else if(ev.key==="Escape"){box.style.display="none";inp.blur();return;}
    items.forEach((el,i)=>el.classList.toggle("active",i===srSel));});
  box.addEventListener("mousedown",ev=>{const el=ev.target.closest(".sr");
    if(el){reveal(el.getAttribute("data-id"));box.style.display="none";inp.value="";}});
  document.addEventListener("click",ev=>{if(!ev.target.closest("#searchwrap"))box.style.display="none";});
  let KPREV=null;
  document.addEventListener("keydown",ev=>{
    const ae=document.activeElement,typing=ae&&(ae.tagName==="INPUT"||ae.tagName==="TEXTAREA"||ae.tagName==="SELECT");
    if(ev.key==="/"){if(!typing&&ae!==inp){ev.preventDefault();inp.focus();inp.select();}return;}
    if(ev.key==="Escape"){if($("modalbg").classList.contains("open"))$("modalbg").classList.remove("open");
      else{S.sel=null;KPREV=null;computeOverlay();closeDrawer();dirty=true;}return;}
    if(typing)return;
    if((ev.key==="ArrowRight"||ev.key==="ArrowLeft")&&S.sel&&nodeById[S.sel]){
      ev.preventDefault();
      let nbs=[...neighborSet(S.sel)].filter(id=>id!==S.sel&&nodeById[id]).sort();
      if(!nbs.length)return;
      if(nbs.length>1&&KPREV)nbs=nbs.filter(id=>id!==KPREV);
      const tgt=ev.key==="ArrowRight"?nbs[0]:nbs[nbs.length-1];
      KPREV=S.sel;select(tgt);centerOn(tgt,Math.max(T.k,.9));return;}
    if(ev.key==="Enter"&&S.sel){ev.preventDefault();reveal(S.sel);}});}

/* ---------- canvas interactions ---------- */
function wireCanvas(){
  canvas.addEventListener("mousemove",ev=>{
    const r=canvas.getBoundingClientRect(),n=pick(ev.clientX-r.left,ev.clientY-r.top);
    const tt=$("tooltip");
    S.hover=n?n.id:null;dirty=true;
    canvas.style.cursor=n?"pointer":"grab";
    if(n){tt.style.display="block";
      tt.style.left=Math.min(ev.clientX-r.left+14,stage.clientWidth-270)+"px";
      tt.style.top=Math.min(ev.clientY-r.top+12,stage.clientHeight-120)+"px";
      let t1="",t2="",t3="";
      if(n.kind==="company"){const c=CMP[n.id];t1=n.id;t2=c.name;
        t3=(GRP[c.group]?GRP[c.group].name:"")+(c.off?" · off-index":"")+(c.flag?" · "+c.flag:"");}
      else if(n.kind==="group"){t1=SECTORS[n.sector].name;t2=n.label;t3=GRP[n.gid].members.length+" names · click to "+(S.expG.has(n.gid)?"inspect":"open");
        const gi=shockInfo("g:"+n.gid);if(gi&&gi.n)t3=gi.n+"/"+gi.N+" shocked (avg "+(gi.m>0?"+":"")+gi.m.toFixed(1)+") · "+t3;}
      else if(n.kind==="sector"){t1="Sector";t2=n.label;t3="click to expand into coverage groups";
        const ssi=shockInfo("s:"+n.code);if(ssi&&ssi.n)t3=ssi.n+"/"+ssi.N+" shocked (avg "+(ssi.m>0?"+":"")+ssi.m.toFixed(1)+") · "+t3;}
      else if(n.kind==="top"){t1="Top line";t2=n.label;t3="where the money starts";}
      else if(n.kind==="reg"){t1="Regulator";t2=n.label;t3="";}
      else{t1="Macro factor";t2=n.label;t3="click for exposure + shock";}
      tt.innerHTML='<div class="tt-t">'+esc(t1)+'</div><div class="tt-n">'+esc(t2)+'</div>'+(t3?'<div class="tt-s">'+esc(t3)+"</div>":"");}
    else tt.style.display="none";});
  canvas.addEventListener("mouseleave",()=>{S.hover=null;$("tooltip").style.display="none";dirty=true;});
  canvas.addEventListener("click",ev=>{
    const r=canvas.getBoundingClientRect(),n=pick(ev.clientX-r.left,ev.clientY-r.top);
    if(!n){S.sel=null;computeOverlay();closeDrawer();dirty=true;return;}
    if(n.kind==="sector"){S.expS.add(n.code);buildGraph();return;}
    if(n.kind==="group"){if(!S.expG.has(n.gid)){S.expG.add(n.gid);buildGraph();}
      else select("g:"+n.gid);return;}
    if(n.kind==="top"||n.kind==="reg"){select("t:"+n.tid);return;}
    if(n.kind==="macro"){select("m:"+n.fid);return;}
    select(n.id);});}

/* ---------- drawer actions ---------- */
function wireDrawer(){
  $("drawer").addEventListener("click",ev=>{
    const go=ev.target.closest("[data-go]");
    if(go){reveal(go.getAttribute("data-go"));return;}
    const sf=ev.target.closest("[data-shockfam]");
    if(sf){runShock("f:"+sf.getAttribute("data-shockfam"),S.shockDir||1);return;}
    const act=ev.target.closest("[data-act]");if(!act)return;
    const a=act.getAttribute("data-act");
    if(a==="close"){S.sel=null;computeOverlay();closeDrawer();dirty=true;}
    else if(a==="center"&&S.sel)centerOn(S.sel,Math.max(T.k,1.3));
    else if(a==="cmpA"&&S.sel){S.cmp[0]=S.sel;if(S.cmp[1])showCompare();}
    else if(a==="cmpB"&&S.sel){S.cmp[1]=S.sel;if(S.cmp[0])showCompare();}
    else if(a==="clearCmp"){S.cmp=[null,null];closeDrawer();}
    else if(a==="trace"&&S.sel&&CMP[S.sel]){const d=driversOf(S.sel).d[0];
      if(d){const v="f:"+d[0];if($("shockSrc").querySelector('option[value="'+v+'"]'))$("shockSrc").value=v;runShock(v,1);}}
    else if(a==="traceSrc"){runShock(act.getAttribute("data-src"),parseInt(act.getAttribute("data-dir"),10));}
    else if(a==="clearShock")clearShock();
    else if(a==="compRun"&&COMP)runCustomScenario({n:COMP.n,r:COMP.r});
    else if(a==="compEdit")openComposer();
    else if(a==="compCopy"&&COMP){
      const idg="custom_"+COMP.n.toLowerCase().replace(/[^a-z0-9]+/g,"_").replace(/^_+|_+$/g,"").slice(0,24);
      const line=JSON.stringify([idg,COMP.n,"Composed "+DATA_VERSION+".",COMP.r])+",";
      if(navigator.clipboard&&navigator.clipboard.writeText)
        navigator.clipboard.writeText(line).then(()=>toast("Preset row copied \u2014 paste into SCENARIOS to keep it."),()=>{window.prompt("Copy this SCENARIOS row:",line);});
      else window.prompt("Copy this SCENARIOS row:",line);}
    else if(a==="csvShock"){if(S.shockMap&&download(shockCSVName()+".csv",buildShockCSV(),"text/csv")){toast("CSV exported.");announce("CSV exported");}}
    else if(a==="lensOff"){S.lens=false;computeOverlay();dirty=true;closeDrawer();}
    else if(a==="expandG"){S.expG.add(act.getAttribute("data-g"));buildGraph();showGroup(act.getAttribute("data-g"));}
    else if(a==="collapseG"){S.expG.delete(act.getAttribute("data-g"));buildGraph();showGroup(act.getAttribute("data-g"));}
    else if(a==="centerG")centerOn("g:"+act.getAttribute("data-g"),Math.max(T.k,.9));});}

/* ---------- about ---------- */
function aboutHTML(){return[
"<h3>What this is</h3>",
"<p>An interactive working map of the S&amp;P 500 as a system: every constituent wired to the money that funds it (top band), the macro forces underneath it (bottom band), the disclosed supplier/customer relationships that run through it, and its own five-driver stack. New in v3: preset scenario shocks, a portfolio X-ray for pasted books, shareable view links, a chokepoint scan, and an in-browser correlation check.</p>",
"<p><em>Data snapshot: "+DATA_VERSION+" &mdash; membership, money-flow edges and driver stacks are authored as of that date.</em></p>",
"<h3>Every name has its own drivers</h3>",
"<p>All ~529 names (index constituents plus off-index anchors like TSMC, SpaceX and the GSEs) carry an individually written stack of five drivers: what actually moves that specific company, in its own words, with direction and a High/Medium/Low weight. No more group defaults &mdash; Rocket Lab is priced on Neutron, not on air travel.</p>",
"<h3>The driver family tree</h3>",
"<p>Each driver is tagged into a multi-level family tree: specific families (LEAP aftermarket flight-hours) nest into themes (aerospace aftermarket) which nest into the macro roots drawn in the bottom band (air travel). Two names are &ldquo;linked&rdquo; only as deeply as their families genuinely converge &mdash; matches that share nothing below a broad macro root are suppressed as noise. A handful of families carry weighted cross-links where reality has two parents: aviation satcom sits under satcom demand but keeps a 0.3 link to air travel, so an air-travel shock brushes Iridium faintly and misses Rocket Lab entirely, exactly as it should.</p>",
"<h3>How it is grounded</h3>",
"<ul><li><b>Universe:</b> constituent snapshot through the June 22, 2026 rebalance, run slightly wide (~510 tickers) so nothing relevant is missed; names with pending corporate actions carry a flag badge.</li>",
"<li><b>Lines:</b> each curated link carries a basis tag &mdash; <b>10-K</b>, <b>disclosed</b>, <b>known</b>, or <b>inferred</b> (off by default).</li>",
"<li><b>Driver stacks:</b> qualitative and directional, authored per company as a reading of public disclosure and market debate as of July 2026 &mdash; not regression betas.</li></ul>",
"<h3>Shocks</h3>",
"<p>Shock any macro factor, any industry family or theme from the tree, or any money source. The impulse cascades down the tree, attenuating at each level and flowing across cross-links, then passes 0.45&times; through supply chains from customers to suppliers. Direction buttons speak each factor&rsquo;s language &mdash; Raise/Cut rates, Widen/Tighten spreads, Close/Break deals. A screen, not a model.</p>",
"<h3>Scenarios</h3>",
"<p>Preset shocks &mdash; Recession, Stagflation, AI capex bust, Taiwan escalation, Hurricane season, Credit event &mdash; are vectors of weighted seeds summed through the same cascade: five or six (source, direction, magnitude) rows each, editable in the SCENARIOS array near the top of the file. No new math, only composition.</p>",
"<h3>Portfolio X-ray</h3>",
"<p>Paste a book &mdash; one <i>TICKER weight</i> per line, shorts as negative weights &mdash; and the X-ray sums every name&rsquo;s driver stack into the book&rsquo;s aggregate exposure, rolled up the family tree, then ranks index names whose stacks lean the other way on your dominant families: <b>offsetting exposures</b>, cited back to written drivers &mdash; not statistical hedges, not recommendations. The book stays on this page and is never written into view links.</p>",
"<h3>Sharing a view</h3>",
"<p>Checked groups, expansions, toggles, the active shock or scenario, and the selection serialize into the URL hash as you work &mdash; bookmark the page to keep a view, or use <b>Copy view</b> / <b>Paste view</b> in the top bar to move one between sessions. Works from a local file; no server involved.</p>",
"<h3>Chokepoints</h3>",
"<p>Every supply line now carries a substitutability grade (sole / duo / comp), and a numeric revenue share where disclosure supports one. Where authored, pass-through uses the share &mdash; anchored so ~37.5% maps to the old High weight &mdash; and scales by substitutability: sole transmits in full, competitive dampens to 0.65&times;. The chokepoint scan ranks suppliers by &Sigma; dependency weight &times; lack of alternatives; the channel scan mirrors it, ranking customers by how much supplier revenue concentrates in them.</p>",
"<h3>Correlation check</h3>",
"<p>Paste a CSV of daily closes or returns and the map compares realized pairwise correlation against tree-predicted linkage, entirely in-browser. Two lists fall out: pairs that correlate but share nothing in the tree (missing-line candidates) and pairs the tree couples that the market ignores (stale data, or a hypothesis worth work).</p>",
"<h3>Composer &amp; catalysts</h3>",
"<p>The composer (in the shock section) builds custom seed vectors through the same cascade; <b>Copy preset row</b> emits a line to paste into SCENARIOS so a keeper becomes permanent. The catalysts panel surfaces the "+CATALYSTS.length+" drivers that carry a discrete date &mdash; deal closes, patent cliffs, program milestones &mdash; bucketed into the next 90 days; (est.) marks expected windows rather than set dates.</p>",
"<h3>Accessibility &amp; exports</h3>",
"<p>Arrow keys walk a selection across its neighbours (Enter reveals, Esc clears); the colorblind toggle in Layers swaps shocks to blue/orange and adds direction glyphs beside shocked nodes; selections and shocks are announced for screen readers. PNG exports the current view; the shock, scenario and X-ray panels export CSV. The file runs fully offline &mdash; d3 is inlined.</p>",
"<h3>Data changelog</h3>",
"<ul>"+DATA_LOG.map(l2=>"<li><b>"+l2[0]+"</b> ("+l2[1]+") &mdash; "+l2[2]+"</li>").join("")+"</ul>",
"<h3>The overlap lens</h3>",
"<p>The lens scans every checked name &mdash; expanded or not &mdash; for cross-sector pairs that share a driver family, and draws them at whatever resolution the map is in: sector-to-sector bundles weighted by pair count when collapsed, exact company pairs when expanded. Expand a sector and watch its bundle resolve.</p>",
"<h3>What it is not</h3>",
"<p>Not a live data feed, not market-cap accurate (node size is a coarse tier), and not investment advice. Verify anything decision-relevant against primary filings.</p>",
"<h3>Editing</h3>",
"<p>Everything lives in plain arrays near the top of this file&rsquo;s script (SECTORS, MACROS, TOPLINES, GROUPS, COMPANIES, FAMILIES, XLINKS, CDRV, EDGES). Re-rank a driver stack or graft a new family onto the tree by editing one line &mdash; the map rebuilds itself.</p>",
"<h3>Reading the map</h3>",
"<p>Diamonds on top are where money originates. Wide brass lines carry it down into sectors and companies. Thin brass arrows are supplier\u2192customer relationships (money flows against the arrow). Triangles below are macro factors; teal dashed links are overlap-lens pairs; violet dashed links are the hidden, under-the-surface connections &mdash; toggle them in the rail.</p>"].join("");}

/* ---------- boot ---------- */
function boot(){
  buildTree();buildToggles();populateShock();buildIndex();wireSearch();wireCanvas();wireDrawer();
  $("btnExpandStep").addEventListener("click",()=>{
    const ps=SECT_ORDER.filter(c=>sectorState(c)>0&&!S.expS.has(c));
    const pg=ps.length?[]:GROUP_IDS.filter(g=>S.checked.has(g)&&!S.expG.has(g));
    if(!ps.length&&!pg.length)return;
    ps.forEach(c=>S.expS.add(c));pg.forEach(g=>S.expG.add(g));
    buildGraph();setTimeout(fitView,700);});
  $("btnExpandAll").addEventListener("click",()=>{
    SECT_ORDER.forEach(c=>{if(sectorState(c)>0)S.expS.add(c);});
    GROUP_IDS.forEach(g=>{if(S.checked.has(g))S.expG.add(g);});
    buildGraph();setTimeout(fitView,700);});
  $("btnCollapseStep").addEventListener("click",()=>{
    if(S.expG.size)S.expG.clear();
    else if(S.expS.size)S.expS.clear();
    else return;
    buildGraph();
    if(S.sel&&!nodeById[S.sel]){S.sel=null;computeOverlay();closeDrawer();dirty=true;}
    setTimeout(fitView,700);});
  $("btnCollapseAll").addEventListener("click",()=>{S.expS.clear();S.expG.clear();S.sel=null;
    closeDrawer();buildGraph();setTimeout(fitView,700);});
  $("btnAbout").addEventListener("click",()=>{$("modalTitle").textContent="About this map";
    $("modalSub").textContent="A working instrument, not a data feed \u2014 read the grounding notes below.";
    $("modal").classList.remove("wide");$("modalbody").innerHTML=aboutHTML();$("modalbg").classList.add("open");});
  $("btnXray").addEventListener("click",openXray);
  $("btnCorr").addEventListener("click",openCorr);
  $("chokeBtn").addEventListener("click",showChokepoints);
  $("chanBtn").addEventListener("click",showChannels);
  $("btnCopyView").addEventListener("click",copyView);
  $("btnPasteView").addEventListener("click",pasteView);
  window.addEventListener("hashchange",()=>{const h=location.hash.slice(1);
    if(h===LASTHASH)return;const o=parseState(h);if(o)applyState(o);});
  $("modalClose").addEventListener("click",()=>$("modalbg").classList.remove("open"));
  $("modalbg").addEventListener("click",ev=>{if(ev.target===$("modalbg"))$("modalbg").classList.remove("open");});
  $("selAllSect").addEventListener("click",()=>{GROUP_IDS.forEach(g=>S.checked.add(g));buildGraph();syncTree();});
  $("selNoSect").addEventListener("click",()=>{GROUP_IDS.forEach(g=>S.checked.delete(g));buildGraph();syncTree();});
