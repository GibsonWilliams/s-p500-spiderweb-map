/* ---------- portfolio x-ray (v3) ---------- */
let XBOOK="",XLAST=null;
function parseBook(txt){
  const rows=[],errs=[],seen={};
  String(txt||"").split(/\n+/).forEach(line=>{
    const t2=line.trim();if(!t2)return;
    const m2=t2.match(/^([A-Za-z][A-Za-z.\-]{0,6})[\s,;:]+(-?\d+(?:\.\d+)?)\s*%?$/);
    if(!m2){errs.push(t2.length>40?t2.slice(0,40)+"\u2026":t2);return;}
    const tk=m2[1].toUpperCase(),w=parseFloat(m2[2]);
    if(!CMP[tk]){errs.push(tk+" \u2014 not in universe");return;}
    if(seen[tk]!=null)rows[seen[tk]][1]+=w;
    else{seen[tk]=rows.length;rows.push([tk,w]);}});
  return{rows,errs};}
function stackExposure(tk,w,exp){
  driversOf(tk).d.forEach(d=>{const sg=SGN(d[1]);if(!sg)return;
    const base=sg*WVAL[d[2]]*w;
    famChain(d[0]).forEach((f,i)=>{exp[f]=(exp[f]||0)+base*Math.pow(.72,i);});});}
function bookExposure(rows){
  const exp={};rows.forEach(r=>stackExposure(r[0],r[1]/100,exp));return exp;}
function computeXray(rows){
  const exp=bookExposure(rows);
  const ids=Object.keys(exp).filter(f=>Math.abs(exp[f])>.01);
  const byMag=(a,b)=>Math.abs(exp[b])-Math.abs(exp[a]);
  const roots=ids.filter(f=>f.indexOf("m:")===0).sort(byMag);
  const fams=ids.filter(f=>f.indexOf("m:")!==0).sort(byMag);
  const dom=ids.slice().sort(byMag).slice(0,10);
  const inBook=new Set(rows.map(r=>r[0]));
  const offs=[];
  Object.keys(CMP).forEach(tk=>{
    if(inBook.has(tk)||CMP[tk].off)return;
    const ce={};stackExposure(tk,1,ce);
    let sc=0;const hits=[];
    dom.forEach(f=>{if(ce[f]){const c2=exp[f]*ce[f];sc+=c2;if(c2<0)hits.push([f,c2]);}});
    if(sc<-.05){hits.sort((a,b)=>a[1]-b[1]);
      offs.push({tk,sc,hits:hits.slice(0,3).map(h=>h[0])});}});
  offs.sort((a,b)=>a.sc-b.sc);
  return{exp,roots,fams,dom,offsets:offs.slice(0,14)};}
