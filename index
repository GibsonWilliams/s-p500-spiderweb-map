const SUBF={sole:1,duo:.85,comp:.65},LACK={sole:1,duo:.6,comp:.25};
function edgeBaseW(e){return (typeof e[6]==="number")?Math.max(.35,Math.min(1.15,.25+2*e[6])):({H:1,M:.75,L:.5}[e[4]]||.75);}
function edgeWf(e){return edgeBaseW(e)*((e[7]&&SUBF[e[7]])?SUBF[e[7]]:1);}
function computeShock(seeds){
