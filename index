    INDEX.push({id:tk,tk,nm:c.name,gp:(GRP[c.group]?GRP[c.group].name:"")+(c.off?" · off-index":""),k:1});});
  GROUP_IDS.forEach(g=>INDEX.push({id:"g:"+g,tk:"",nm:GRP[g].name,gp:SECTORS[GRP[g].sector].name+" group",k:2}));
  SECT_ORDER.forEach(c=>INDEX.push({id:"s:"+c,tk:"",nm:SECTORS[c].name,gp:"sector",k:3}));
  TOPLINES.forEach(t=>INDEX.push({id:"t:"+t[0],tk:"",nm:t[1],gp:t[2]==="reg"?"regulator":"top-line source",k:4}));
  MACROS.forEach(m=>INDEX.push({id:"m:"+m[0],tk:"",nm:m[1],gp:"macro factor",k:5}));}
function doSearch(q){
  q=q.trim().toLowerCase();const box=$("searchresults");
  if(!q){box.style.display="none";return;}
  const scored=[];INDEX.forEach(it=>{
    const tkm=it.tk&&it.tk.toLowerCase().indexOf(q)===0;
    const nmi=it.nm.toLowerCase().indexOf(q);
    if(tkm||nmi>=0)scored.push({it,sc:(tkm?100:0)+(nmi===0?40:(nmi>0?10:0))-it.k});});
  scored.sort((a,b)=>b.sc-a.sc);
  const top=scored.slice(0,9);srSel=-1;
  box.innerHTML=top.map((s,i)=>'<div class="sr" data-i="'+i+'" data-id="'+esc(s.it.id)+'">'+
    '<span class="tk">'+esc(s.it.tk||"&mdash;")+'</span><span class="nm">'+esc(s.it.nm)+'</span><span class="gp">'+esc(s.it.gp)+"</span></div>").join("");
  box.style.display=top.length?"block":"none";}
function wireSearch(){
  const inp=$("search"),box=$("searchresults");
