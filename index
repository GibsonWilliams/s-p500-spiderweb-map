function bootLint(){const iss=[];
  const okFam=id=>!!FAMILIES[id];
  const okMac=id=>!!(id&&id.indexOf("m:")===0&&MAC[id.slice(2)]);
  const okTop=id=>!!(id&&id.indexOf("t:")===0&&TOPN[id.slice(2)]);
  Object.keys(FAMILIES).forEach(f=>{const p=FAMILIES[f][0];
    if(p&&!okFam(p)&&!okMac(p))iss.push("FAMILIES: "+f+" has unresolvable parent '"+p+"'");});
  XLINKS.forEach(x=>{if(!okFam(x[0]))iss.push("XLINKS: unknown source family '"+x[0]+"'");
    if(!okFam(x[1])&&!okMac(x[1])&&!okTop(x[1]))iss.push("XLINKS: unknown target '"+x[1]+"'");});
  Object.keys(CDRV).forEach(tk=>{if(!CMP[tk])iss.push("CDRV: stack for unknown ticker '"+tk+"'");
    const d=CDRV[tk].d||[];if(d.length!==5)iss.push("CDRV: "+tk+" has "+d.length+" drivers (want 5)");
    d.forEach(x=>{if(!okFam(x[0])&&!okMac(x[0]))iss.push("CDRV: "+tk+" driver family '"+x[0]+"' not in tree");
      if(!WVAL[x[2]])iss.push("CDRV: "+tk+" bad weight '"+x[2]+"'");});
    (CDRV[tk].t||[]).forEach(t=>{if(!TOPN[t])iss.push("CDRV: "+tk+" topline '"+t+"' unknown");});});
  Object.keys(CMP).forEach(tk=>{if(!CDRV[tk])iss.push("CMP: "+tk+" has no driver stack");
    if(!GRP[CMP[tk].group])iss.push("CMP: "+tk+" group '"+CMP[tk].group+"' unknown");});
  GROUP_IDS.forEach(g=>{GRP[g].members.forEach(tk=>{if(!CMP[tk])iss.push("GRP "+g+": member '"+tk+"' not in CMP");});
    (GRP[g].toplines||[]).forEach(t=>{if(!TOPN[t])iss.push("GRP "+g+": topline '"+t+"' unknown");});});
  const resolves=x=>!!(CMP[x]||TOPN[x]||(x&&x.indexOf("g:")===0&&GRP[x.slice(2)])||(x&&x.indexOf("m:")===0&&MAC[x.slice(2)])||(x&&x.indexOf("s:")===0&&SECTORS[x.slice(2)]));
  EDGES.forEach((e,i)=>{if(!resolves(e[0]))iss.push("EDGES["+i+"]: endpoint '"+e[0]+"' unresolvable");
    if(!resolves(e[1]))iss.push("EDGES["+i+"]: endpoint '"+e[1]+"' unresolvable");});
  Object.keys(CMP).forEach(tk=>{if(TOPN[tk])iss.push("COLLISION: '"+tk+"' is both ticker and topline id");
    if(MAC[tk])iss.push("COLLISION: '"+tk+"' is both ticker and macro id");});
  SCENARIOS.forEach(sc=>{(sc[3]||[]).forEach(sd=>{const s2=sd[0];
    const okS=(s2.indexOf("m:")===0&&MAC[s2.slice(2)])||(s2.indexOf("f:")===0&&FAMILIES[s2.slice(2)])||(s2.indexOf("t:")===0&&TOPN[s2.slice(2)]);
    if(!okS)iss.push("SCENARIOS: "+sc[0]+" seed '"+s2+"' unresolvable");
    if(sd[1]!==1&&sd[1]!==-1)iss.push("SCENARIOS: "+sc[0]+" seed '"+s2+"' bad direction");
    if(!(sd[2]>0&&sd[2]<=1.5))iss.push("SCENARIOS: "+sc[0]+" seed '"+s2+"' bad magnitude");});});
  EDGES.forEach((e,i)=>{if(e[2]!=="supply")return;
    if(e.length>6&&e[6]!=null&&!(typeof e[6]==="number"&&e[6]>0&&e[6]<=.9))iss.push("EDGES["+i+"]: bad share '"+e[6]+"'");
    if(e.length>7&&e[7]!=null&&!SUBF[e[7]])iss.push("EDGES["+i+"]: bad substitutability '"+e[7]+"'");});
  const FFORM={"10-K/Q":1,"20-F":1,"none":1},seenF={};
  FILINGS.forEach((f,i)=>{if(!CMP[f[0]])iss.push("FILINGS["+i+"]: unknown ticker '"+f[0]+"'");
    if(seenF[f[0]])iss.push("FILINGS["+i+"]: duplicate '"+f[0]+"'");seenF[f[0]]=1;
    if(!/^\d{4}-\d{2}-\d{2}$/.test(f[1]))iss.push("FILINGS["+i+"]: bad date '"+f[1]+"'");
    if(!FFORM[f[2]])iss.push("FILINGS["+i+"]: bad form '"+f[2]+"'");});
  Object.keys(CMP).forEach(tk=>{if(!seenF[tk])iss.push("FILINGS: missing row for "+tk);});
  const CATF={deal_completion:1,patent_cliff:1,program_milestones:1};
  CATALYSTS.forEach((c,i)=>{if(!CMP[c[0]])iss.push("CATALYSTS["+i+"]: unknown ticker '"+c[0]+"'");
    if(!/^\d{4}-\d{2}(-\d{2})?$/.test(c[1]))iss.push("CATALYSTS["+i+"]: bad date '"+c[1]+"'");
    if(!CATF[c[3]])iss.push("CATALYSTS["+i+"]: family '"+c[3]+"' out of scope");
    if(c[4]!==0&&c[4]!==1)iss.push("CATALYSTS["+i+"]: bad est flag");});
  window.LINT=iss;iss.forEach(m2=>console.warn("[lint] "+m2));
  console.log("[lint] "+(iss.length?iss.length+" issue(s) — see warnings above":"clean — data integrity OK"));}
document.addEventListener("DOMContentLoaded",boot);
