/* ---------- driver-family tree ---------- */
function famName(f){return FAMILIES[f]?FAMILIES[f][1]:(f&&f.indexOf("m:")===0&&MAC[f.slice(2)]?MAC[f.slice(2)].name:f);}
const FAMCH={};
function famChain(f){if(FAMCH[f])return FAMCH[f];
  const out=[];let cur=f,g=0;
  while(cur&&g++<8){out.push(cur);const e=FAMILIES[cur];if(!e)break;cur=e[0];
    if(cur&&cur.indexOf("m:")===0){out.push(cur);break;}}
  return FAMCH[f]=out;}
function famRoot(f){const ch=famChain(f);return ch[ch.length-1];}
const XL={};XLINKS.forEach(x=>{(XL[x[0]]=XL[x[0]]||[]).push([x[1],x[2]]);});
function relevance(shock,fam){
  let best=0;const chain=famChain(fam);
  const di=chain.indexOf(shock);
  if(di>=0)best=Math.max(best,Math.pow(.72,di));
  if(shock&&FAMILIES[shock]){const sch=famChain(shock),ri=sch.indexOf(fam);
    if(ri>0)best=Math.max(best,Math.pow(.45,ri));}
  chain.forEach((node,k)=>{(XL[node]||[]).forEach(([tgt,w])=>{
    if(tgt===shock)best=Math.max(best,w*Math.pow(.72,k));
    else if(FAMILIES[tgt]){const tch=famChain(tgt),ti=tch.indexOf(shock);
      if(ti>=0)best=Math.max(best,w*Math.pow(.72,k+ti));}});});
  return best;}
function getVerbs(id){
  if(!id)return VERBS._default;
  if(id.indexOf("t:")===0)return VERBS._top;
  let f=id.indexOf("f:")===0?id.slice(2):id;
  if(f.indexOf("m:")===0)return VERBS[f]||VERBS._default;
  let g=0;while(f&&FAMILIES[f]&&g++<8){if(VERBS[f])return VERBS[f];const p=FAMILIES[f][0];
    if(p&&p.indexOf("m:")===0)return VERBS[p]||VERBS._default;f=p;}
  return VERBS[f]||VERBS._default;}
function allCheckedTk(){return Object.keys(CMP).filter(tk=>S.checked.has(CMP[tk].group));}
function memberList(id){ if(CMP[id])return[id];
  if(id&&id.startsWith("g:")){const g=GRP[id.slice(2)];return g?g.members.slice():[];}
  return[];}

/* ---------- state ---------- */
const S={checked:new Set(GROUP_IDS),expS:new Set(),expG:new Set(),
