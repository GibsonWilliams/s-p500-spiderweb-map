    $("stage").classList.toggle("railhidden",hid);
    $("railtoggle").innerHTML=hid?"&#9656;":"&#9666;";resize();});
  $("zin").addEventListener("click",()=>d3.select(canvas).transition().duration(200).call(zoom.scaleBy,1.35));
  $("zout").addEventListener("click",()=>d3.select(canvas).transition().duration(200).call(zoom.scaleBy,1/1.35));
  $("zfit").addEventListener("click",fitView);
  $("zpng").addEventListener("click",()=>{
    const fin=bl=>{if(!bl){toast("PNG export not available in this browser.");return;}
      const u=URL.createObjectURL(bl),a=document.createElement("a");
      a.href=u;a.download="sp500-map-"+new Date().toISOString().slice(0,10)+".png";
      document.body.appendChild(a);a.click();
      setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(u);},400);
      toast("PNG exported \u2014 current view, current zoom.");announce("PNG exported");};
    if(canvas.toBlob)canvas.toBlob(fin,"image/png");
    else try{const a=document.createElement("a");a.href=canvas.toDataURL("image/png");
