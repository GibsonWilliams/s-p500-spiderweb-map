<style>
:root{
  --ink:#0b0e14;          /* deep ink-blue field */
  --ink2:#0e1219;
  --panel:#11151e;
  --panel2:#161b26;
  --hair:#242b3a;
  --hair2:#1a2030;
  --ivory:#ece6d8;
  --ivory-dim:#9b978c;
  --ivory-faint:#6b685f;
  --brass:#c2a24b;        /* money flow */
  --brass-dim:#8a7436;
  --pos:#6fae8f;
  --neg:#c2695e;
  --shared:#5fa0a8;
  --second:#9b7fb8;
  --focus:#e8dcb8;
  --r:8px;
  --serif:"Palatino Linotype","Book Antiqua",Palatino,Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --mono:"SF Mono","Cascadia Code",Menlo,Consolas,"Liberation Mono",monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{background:var(--ink);color:var(--ivory);font-family:var(--sans);font-size:13px}
button{font-family:inherit;color:inherit;background:none;border:none;cursor:pointer}
input{font-family:inherit}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--hair);border-radius:5px}
::-webkit-scrollbar-track{background:transparent}

/* ---------- top bar ---------- */
#topbar{position:fixed;top:0;left:0;right:0;height:52px;background:linear-gradient(180deg,var(--panel) 0%,rgba(17,21,30,.96) 100%);border-bottom:1px solid var(--hair);display:flex;align-items:center;gap:14px;padding:0 14px;z-index:40}
#brand{display:flex;flex-direction:column;line-height:1.1;min-width:0}
#brand .t{font-family:var(--serif);font-size:16px;letter-spacing:.02em;white-space:nowrap}
#brand .s{font-size:10px;color:var(--ivory-dim);letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
#searchwrap{position:relative;flex:1;max-width:340px}
#search{width:100%;background:var(--ink2);border:1px solid var(--hair);border-radius:6px;color:var(--ivory);padding:7px 10px 7px 30px;font-size:13px;outline:none}
#search:focus{border-color:var(--brass-dim);box-shadow:0 0 0 2px rgba(194,162,75,.15)}
#searchwrap .icon{position:absolute;left:9px;top:8px;color:var(--ivory-faint);font-size:12px}
#searchresults{position:absolute;top:36px;left:0;right:0;background:var(--panel2);border:1px solid var(--hair);border-radius:6px;max-height:300px;overflow-y:auto;display:none;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.5)}
#searchresults .sr{padding:7px 10px;cursor:pointer;display:flex;gap:8px;align-items:baseline;border-bottom:1px solid var(--hair2)}
#searchresults .sr:last-child{border-bottom:none}
#searchresults .sr:hover,#searchresults .sr.active{background:var(--hair2)}
#searchresults .sr .tk{font-family:var(--mono);font-size:12px;color:var(--brass);min-width:52px}
#searchresults .sr .nm{color:var(--ivory);font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#searchresults .sr .gp{color:var(--ivory-faint);font-size:10px}
#topbar .spacer{flex:1}
.tbtn{border:1px solid var(--hair);border-radius:6px;padding:6px 11px;font-size:12px;color:var(--ivory-dim);background:var(--ink2);white-space:nowrap}
