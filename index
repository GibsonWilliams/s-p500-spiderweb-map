/* ---------- tree ---------- */
function buildTree(){
  const el=$("sectree");let h="";
  SECT_ORDER.forEach(c=>{
    const gs=GROUP_IDS.filter(g=>GRP[g].sector===c);
    const nco=gs.reduce((a,g)=>a+GRP[g].members.filter(m=>!CMP[m].off).length,0);
    h+='<div class="sect" data-s="'+c+'"><div class="sect-row"><span class="car">&#9656;</span>'+
    '<span class="cb" data-cbs="'+c+'"></span><span class="chip" style="background:'+SECTORS[c].color+'"></span>'+
    '<span class="nm">'+esc(SECTORS[c].name)+'</span><span class="ct">'+nco+"</span></div><div class=\"grp-list\">";
    gs.forEach(g=>{h+='<div class="grp-row" data-g="'+g+'"><span class="cb" data-cbg="'+g+'"></span>'+
      '<span class="nm">'+esc(GRP[g].name)+'</span><span class="ct">'+GRP[g].members.length+"</span></div>";});
    h+="</div></div>";});
  el.innerHTML=h;syncTree();
  el.addEventListener("click",ev=>{
    const cbs=ev.target.closest("[data-cbs]"),cbg=ev.target.closest("[data-cbg]");
    if(cbg){const g=cbg.getAttribute("data-cbg");
      if(S.checked.has(g))S.checked.delete(g);else S.checked.add(g);
      buildGraph();syncTree();return;}
    if(cbs){const c=cbs.getAttribute("data-cbs");
      const gs=GROUP_IDS.filter(g=>GRP[g].sector===c);
      const all=gs.every(g=>S.checked.has(g));
      gs.forEach(g=>{if(all)S.checked.delete(g);else S.checked.add(g);});
      buildGraph();syncTree();return;}
    const row=ev.target.closest(".sect-row");
    if(row){const sect=row.parentElement;sect.classList.toggle("open");
      row.classList.toggle("open");return;}
    const gr=ev.target.closest(".grp-row");
    if(gr){const g=gr.getAttribute("data-g");if(S.checked.has(g))reveal("g:"+g);}});}
function syncTree(){
  SECT_ORDER.forEach(c=>{const st=sectorState(c);
    const cb=document.querySelector('[data-cbs="'+c+'"]');if(!cb)return;
    cb.className="cb"+(st===2?" on":(st===1?" part":""));});
  GROUP_IDS.forEach(g=>{const cb=document.querySelector('[data-cbg="'+g+'"]');if(!cb)return;
    cb.className="cb"+(S.checked.has(g)?" on":"");
    cb.parentElement.classList.toggle("checked",S.checked.has(g));});refreshScans();}

